# Copy to .env.local (git-ignored) and fill in. Never commit real credentials.
# Next.js loads .env and .env.local on the server only; none of these reach the browser.

# Storefront catalogue source: mock (seeded web DB) or erp (RetailERP). Admin → Products always reads RetailERP.
DATA_SOURCE=mock

# Website-owned, writable database: admin users, orders, carts, CMS, productWebMeta.
# Do NOT point this at the RetailERP cluster.
MONGODB_URI=
WEB_DB_NAME=woven_essence_web
LEGACY_BRIDGE_BRANCH_ID=

# RetailERP database (read-only). Admin → Products reads grooretailerp1.barcodeLabel from here.
# ERP_MONGO_URI is accepted as an alias (the name the RetailERP backend's .env uses).
# Falls back to MONGODB_URI when neither is set.
ERP_MONGODB_URI=
ERP_DB_NAME=grooretailerp1
# Optional when the ERP database has more than one e-commerce business.
ERP_ECOMMERCE_BUSINESS_ID=

# Deployed RetailERP web app; serves relative ERP image paths such as /august_8A_images/4A1142.jpg.
ERP_IMAGE_BASE=https://wovenessence.etpl.ai
# DigitalOcean Spaces bucket host(s) holding ERP product photos (comma-separated, exact hosts).
ERP_IMAGE_SPACES_HOSTS=templeimg.blr1.digitaloceanspaces.com

# Optional DigitalOcean Spaces keys (a read-only key is enough). With them, private ERP product
# photos are served through short-lived presigned URLs; without them only public-read photos show.
DO_SPACES_KEY=
DO_SPACES_SECRET=

# NVIDIA API key (nvapi-…) for Admin → AI Assistant; create one at https://build.nvidia.com. Server-only.
# Without it the assistant page loads but cannot answer.
NVIDIA_API_KEY=
# Optional. The model must support tool calling. Default: nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL=
# Optional. Default: https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# WhatsApp OTP login (Meta WhatsApp Cloud API). Keep these server-only.
# The OTP template must be approved in WhatsApp Manager before sending.
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en_US
# Set to 2 if the approved template body uses {{1}} for the code and {{2}} for purpose.
WHATSAPP_OTP_BODY_PARAMS=1
# Set true only when the approved authentication template has a Copy code button.
WHATSAPP_OTP_INCLUDE_BUTTON=false
WHATSAPP_OTP_PURPOSE=Login
WHATSAPP_OTP_TTL_SEC=300
WHATSAPP_OTP_MAX_ATTEMPTS=5
WHATSAPP_OTP_RESEND_COOLDOWN_SEC=30
# Optional separate HMAC key; defaults to JWT_SECRET.
OTP_HASH_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional; online checkout is available only when both Razorpay credentials are configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
