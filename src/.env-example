# ─────────────────────────────────────────────────────────────────────────────
#  Woven Essence — environment (copy to .env; never commit .env)
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5001
NODE_ENV=development
LOG_LEVEL=info                    # debug | info | warn | error
TRUST_PROXY=false                 # true behind nginx / a load balancer
CORS_ORIGINS=http://localhost:5173,http://localhost:5001
SITE_URL=https://www.example.com  # public URL used in sitemap, JSON-LD, emails
PUBLIC_SITE_URL=https://www.example.com

# Database (e-commerce data). V1 name is MONGO_URI and is kept.
MONGO_URI=mongodb://myexcerpt1_db_user:yEXNF7BjVgDRanGI@ac-whe5fum-shard-00-00.e3s8dbr.mongodb.net:27017,ac-whe5fum-shard-00-01.e3s8dbr.mongodb.net:27017,ac-whe5fum-shard-00-02.e3s8dbr.mongodb.net:27017/grooretailerp1?ssl=true&replicaSet=atlas-fwhdop-shard-0&authSource=admin&retryWrites=true&w=majority


# ERP (system of record for barcode / stock / price / GST / HSN / UOM)
# Leave ERP_MONGO_URI empty to read the ERP collections from the same MONGO_URI database.
ERP_MONGO_URI=mongodb+srv://myexcerpt1_db_user:yEXNF7BjVgDRanGI@cluster0.e3s8dbr.mongodb.net/grooretailerp1
ERP_ADAPTER=mongo                 # only adapter shipped; add REST/queue adapters in src/integrations/erp
ERP_PRICE_FIELD=retailPrice       # which barcodeLabel field is the shop selling price (confirm with `npm run erp:discover`)
ERP_IMAGE_BASE=https://wovenessence.etpl.ai   # base for relative image paths stored on ERP rows
ERP_SYNC_INTERVAL_MINUTES=15      # 0 = no scheduled sync (admin "Sync now" still works)
ERP_STOCK_INTERVAL_MINUTES=5      # faster stock-only pass for published products; 0 = off
ERP_SYNC_ON_BOOT=false

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=

# Catalog rules
PUBLISH_MIN_IMAGES=1              # images required before a product can be published (target is 8)
IMAGE_MAX_MB=8
MAX_UPLOAD_MB=25
UPLOAD_ROOT=uploads
LEGACY_BRIDGE=on                  # keeps a V1 Item per V2 product so V1 cart/checkout keep working (Phase A)
LEGACY_BRIDGE_BRANCH_ID=          # branch that owns bridged items; defaults to the oldest active branch
FULFILMENT_BRANCH_CODE=

# Rate limits (requests per minute per IP)
RATE_LIMIT_PUBLIC=300
RATE_LIMIT_ADMIN=600

# AI (optional). Without a key every AI feature falls back to deterministic templates/rules.
NVIDIA_API_KEY=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
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shipping (Shiprocket)
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_BOX_LENGTH_CM=30
SHIPROCKET_BOX_BREADTH_CM=25
SHIPROCKET_BOX_HEIGHT_CM=5

# Email
EMAIL_TRANSPORT=smtp              # smtp | log
EMAIL_FROM="Woven Essence <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Frontend
CLIENT_DEV_URL=http://localhost:5173
# CLIENT_DIST=/absolute/path/to/frontend/dist   (auto-detected: ./frontend/dist)
